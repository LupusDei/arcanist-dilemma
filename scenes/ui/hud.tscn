[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
offset_right = 900.0
offset_bottom = 120.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="ControlsLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
text = "WASD move   Mouse look   Space jump (hold for higher)   Shift dodge   R reset   Esc free mouse
Gamepad: left stick move   right stick look   A jump   B dodge   LB reset"

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.9, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
